{
  "name": "schedule-alerter",
  "version": "0.1.0",
  "description": "Automated teacher schedule scraper with WhatsApp alerts",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "run-once": "tsx --env-file=.env src/cli.ts run-once",
    "test-config": "tsx --env-file=.env src/cli.ts test-config",
    "test-notifier": "tsx --env-file=.env src/cli.ts test-notifier"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "date-fns-tz": "^3.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.16",
    "pino": "^10.3.1",
    "telegraf": "^4.16.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pino": "^7.0.4",
    "nock": "^14.0.17",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
